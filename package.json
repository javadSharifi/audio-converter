{
  "name": "audiflow",
  "private": true,
  "version": "1.6.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:android": "bash scripts/dev-android.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "generate:types": "cargo run --example export_types --manifest-path src-tauri/Cargo.toml",
    "check:types": "cargo run --example export_types --manifest-path src-tauri/Cargo.toml && git diff --exit-code src/types/generated.ts",
    "build:android": "bash scripts/build-android-local.sh",
    "build:android:debug": "bash scripts/build-android-local.sh --debug",
    "android:emulator": "bash scripts/run-android-emulator.sh",
    "android:emulator:rebuild": "bash scripts/run-android-emulator.sh --rebuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:cycles": "madge --circular --extensions ts,tsx src/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.9.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.0.1",
    "madge": "^8.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
