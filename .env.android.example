# Local Android signing configuration (Optional)
# Copy this file to .env.android or secrets.android.env and customize if needed.
# Both files are already added to .gitignore.

# Option 1: Path to local keystore file
# KEYSTORE_PATH="$HOME/.android/release.keystore"

# Option 2: Base64-encoded keystore (same as GitHub Secret ANDROID_KEYSTORE_BASE64)
# KEYSTORE_BASE64=""

