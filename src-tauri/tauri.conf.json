{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioConverter",
  "version": "1.3.2",
  "identifier": "com.audioconverter.app",
  "mainBinaryName": "audio-converter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Converter",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "windows": {
      "nsis": {
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "category": "Music",
    "shortDescription": "Audio Converter and Music Player",
    "fileAssociations": [
      {
        "ext": ["mp3", "flac", "wav", "m4a", "aac", "ogg", "opus", "aiff", "alac", "wma", "weba"],
        "name": "Audio File",
        "description": "Audio Media File",
        "role": "Viewer",
        "mimeType": "audio/*"
      },
      {
        "ext": ["mp4", "mkv", "avi", "mov", "webm", "flv", "wmv"],
        "name": "Video File",
        "description": "Video Media File",
        "role": "Viewer",
        "mimeType": "video/*"
      }
    ]
  }
}
